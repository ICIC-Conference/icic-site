---
import MainLayout from "../layouts/MainLayout.astro";
import homepageData from "../data/homepage";

const { speakerSchedule, conferenceProgram, speakerScheduleDisplayOn, theme, hero, keynote, oralPresentationsPage } = homepageData;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<MainLayout title="Oral Presentations">
  <style>
    .page-body {
      background: var(--cream);
    }

    .page-hero {
      background: var(--navy);
      background-image: url('/images/site/hero-oral.jpg');
      background-size: cover;
      background-position: center;
      padding: 56px 56px 48px;
      min-height: 220px;
      position: relative;
    }

    .page-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(27, 51, 82, 0.72);
    }

    .page-hero .section-label,
    .page-hero h2,
    .page-hero .hero-sub {
      position: relative;
      z-index: 1;
    }

    .page-hero h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 3rem;
      font-weight: 600;
      color: var(--white);
      margin: 0 0 12px 0;
      line-height: 1.25;
      max-width: 720px;
    }

    .page-hero .hero-sub {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 1rem;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.75);
      margin: 0;
      letter-spacing: 0.02em;
    }

    .content-section {
      padding: 56px;
      max-width: 960px;
    }

    .cfp-lede {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--navy);
      margin: 0 0 1.2em 0;
      line-height: 1.6;
      padding-bottom: 1.2em;
      border-bottom: 1px solid var(--rule);
    }

    .intro p {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 1.05rem;
      line-height: 1.75;
      color: var(--text);
      font-weight: 300;
      margin: 0 0 1.4em 0;
    }

    /* Two-column info blocks */
    .info-section {
      border-top: 1px solid var(--rule);
      padding-top: 48px;
      margin-top: 48px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: start;
    }

    .info-block h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.8rem;
      font-weight: 600;
      color: var(--navy);
      margin: 0 0 18px 0;
    }

    .info-block p {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.95rem;
      color: var(--text);
      font-weight: 300;
      line-height: 1.6;
      margin: 0 0 12px 0;
    }

    .info-block ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .info-block ul li {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.95rem;
      color: var(--text);
      font-weight: 300;
      padding: 8px 0 8px 16px;
      position: relative;
      line-height: 1.6;
      border-bottom: 1px solid var(--rule);
    }

    .info-block ul li:first-child {
      border-top: 1px solid var(--rule);
    }

    .info-block ul li::before {
      content: '–';
      position: absolute;
      left: 0;
      color: var(--gold);
    }

    .info-block a {
      color: var(--gold);
      text-decoration: none;
    }

    .info-block a:hover {
      text-decoration: underline;
    }

    .deadline {
      font-weight: 600;
      color: var(--navy);
    }

    /* Participants */
    .participants-section {
      border-top: 1px solid var(--rule);
      padding-top: 48px;
      margin-top: 48px;
    }

    .participants-section h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.8rem;
      font-weight: 600;
      color: var(--navy);
      margin: 0 0 28px 0;
    }

    .participants-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: start;
    }

    .speaker-group h3 {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--gold);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin: 0 0 12px 0;
    }

    .speaker-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .speaker-list li {
      padding: 12px 0;
      border-bottom: 1px solid var(--rule);
      line-height: 1.4;
    }

    .speaker-list li:first-child {
      border-top: 1px solid var(--rule);
    }

    .speaker-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--navy);
      display: block;
    }

    .speaker-affiliation {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.88rem;
      color: var(--muted);
      font-weight: 300;
      display: block;
      margin-top: 2px;
    }

    /* Speaker Schedule */
    .speaker-schedule-section {
      border-top: 1px solid var(--rule);
      padding-top: 48px;
      margin-top: 48px;
    }

    .speaker-schedule-section h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.8rem;
      font-weight: 600;
      color: var(--navy);
      margin: 0 0 28px 0;
    }

    .speaker-time-group {
      margin-bottom: 44px;
    }

    .speaker-time-group:last-child {
      margin-bottom: 0;
    }

    .speaker-time-heading {
      display: flex;
      align-items: baseline;
      gap: 14px;
      margin: 0 0 20px 0;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--rule);
    }

    .speaker-time-heading .time {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.5rem;
      font-weight: 600;
      color: var(--navy);
    }

    .speaker-sessions-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }

    .speaker-session {
      background: var(--white);
      border: 1px solid var(--rule);
    }

    .speaker-session-header {
      padding: 16px 22px;
      background: var(--navy);
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
      flex-wrap: wrap;
    }

    .speaker-session-header .session-label {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--white);
      letter-spacing: 0.02em;
    }

    .speaker-session-header .session-location {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.78rem;
      color: var(--gold-light);
      letter-spacing: 0.05em;
    }

    .speaker-session-chair {
      padding: 10px 22px;
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.85rem;
      color: var(--muted);
      border-bottom: 1px solid var(--rule);
      background: #f0ede6;
    }

    .speaker-session-chair strong {
      color: var(--text);
      font-weight: 600;
    }

    .speaker-papers {
      display: flex;
      flex-direction: column;
    }

    .speaker-paper {
      padding: 18px 22px;
      border-bottom: 1px solid var(--rule);
    }

    .speaker-paper:last-child {
      border-bottom: none;
    }

    .speaker-paper-name {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.98rem;
      font-weight: 600;
      color: var(--navy);
      margin: 0;
    }

    .speaker-paper-affiliation {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.82rem;
      color: var(--muted);
      font-weight: 400;
      margin: 2px 0 0 0;
    }

    .speaker-paper-title {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic;
      font-size: 1.02rem;
      color: var(--text);
      line-height: 1.5;
      margin: 8px 0 0 0;
    }

    /* Closing */
    .closing-note {
      border-top: 1px solid var(--rule);
      padding-top: 32px;
      margin-top: 48px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 24px;
    }

    .closing-note p {
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.9rem;
      color: var(--muted);
      font-weight: 300;
      margin: 0;
      line-height: 1.6;
    }

    .closing-note p a {
      color: var(--gold);
      text-decoration: none;
    }

    .closing-note p a:hover {
      text-decoration: underline;
    }

    .submit-button {
      display: inline-block;
      padding: 14px 28px;
      background: var(--gold);
      color: var(--white) !important;
      font-family: 'Source Sans 3', sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-decoration: none !important;
      border-radius: 4px;
      transition: background 0.15s;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .submit-button:hover {
      background: #9a7020;
    }

    @media (max-width: 860px) {
      .page-hero {
        padding: 40px 28px 36px;
      }

      .content-section {
        padding: 40px 28px;
      }

      .info-section,
      .participants-grid,
      .speaker-sessions-grid {
        grid-template-columns: 1fr;
        gap: 32px;
      }

      .speaker-sessions-grid {
        gap: 24px;
      }

      .closing-note {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>

  <div class="page-body">
    <div class="page-hero">
      <h2>{theme.heading}</h2>
      <p class="hero-sub">{hero.date} · Tunghai University, Taichung</p>
    </div>

    <div class="content-section">

      {conferenceProgram.displayOn && (
        <p class="cfp-lede">The full conference program is now available <a href={`${base}${conferenceProgram.url}`} target="_blank" rel="noopener noreferrer">here</a>.</p>
      )}

      <div class="intro">
        {oralPresentationsPage.intro.split('\n\n').filter((p) => p.trim()).map((para) => (
          <p>{para}</p>
        ))}
      </div>

      {(oralPresentationsPage.submissionsDisplayOn || oralPresentationsPage.conferenceSupportDisplayOn) && (
        <div class="info-section">
          {oralPresentationsPage.submissionsDisplayOn && (
            <div class="info-block">
              <h2>Submissions</h2>
              <ul>
                {oralPresentationsPage.submissionsText.split('\n').filter((l) => l.trim()).map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </div>
          )}

          {oralPresentationsPage.conferenceSupportDisplayOn && (
            <div class="info-block">
              <h2>Conference Support</h2>
              <ul>
                {oralPresentationsPage.conferenceSupportText.split('\n').filter((l) => l.trim()).map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}

      <div class="participants-section">
        <h2>Participants</h2>
        <div class="participants-grid">
          <div class="speaker-group">
            <h3>{keynote.length > 1 ? 'Keynote Speakers' : 'Keynote Speaker'}</h3>
            <ul class="speaker-list">
              {keynote.map((k) => (
                <li>
                  <span class="speaker-name">{k.name}</span>
                  <span class="speaker-affiliation">{k.title}</span>
                </li>
              ))}
            </ul>
          </div>

          {oralPresentationsPage.invitedSpeakersDisplayOn && (
            <div class="speaker-group">
              <h3>Invited Speakers</h3>
              <ul class="speaker-list">
                {oralPresentationsPage.invitedSpeakers.map((s) => (
                  <li>
                    <span class="speaker-name">{s.name}</span>
                    <span class="speaker-affiliation">{s.affiliation}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>

      {speakerScheduleDisplayOn && (
      <div class="speaker-schedule-section">
        <h2>Speaker Schedule</h2>

        {speakerSchedule.map((group) => (
          <div class="speaker-time-group">
            <div class="speaker-time-heading">
              <span class="time">{group.time}</span>
            </div>

            <div class="speaker-sessions-grid">
              {group.sessions.map((session) => (
                <div class="speaker-session">
                  <div class="speaker-session-header">
                    <span class="session-label">{session.label}</span>
                    <span class="session-location">{session.location}</span>
                  </div>
                  <div class="speaker-session-chair">
                    <strong>Chair:</strong> {session.chair}
                  </div>
                  <div class="speaker-papers">
                    {session.papers.map((paper) => (
                      <div class="speaker-paper">
                        <p class="speaker-paper-name">{paper.speaker}</p>
                        <p class="speaker-paper-affiliation">{paper.affiliation}</p>
                        <p class="speaker-paper-title">&ldquo;{paper.title}&rdquo;</p>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      )}

      <div class="closing-note">
        <p>
          {oralPresentationsPage.closingNoteText && (<>{oralPresentationsPage.closingNoteText}<br /></>)}
          Questions may be directed to {oralPresentationsPage.contactName} at <a href={`mailto:${oralPresentationsPage.contactEmail}`}>{oralPresentationsPage.contactEmail}</a>.
        </p>
        {oralPresentationsPage.submitButtonDisplayOn && (
          <a href="https://script.google.com/macros/s/AKfycbyH5PjaNCZnJo2L8LVr6q5uOE4kfyLNDT1CyddGj0MduPqBTxfE_p2KcWuPX8z1cEcE/exec" class="submit-button">Submit an Abstract →</a>
        )}
      </div>

    </div>
  </div>
</MainLayout>